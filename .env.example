APP_PORT=8080
APP_USER=developer
APP_PASSWORD=local-demo-password
POSTGRES_PASSWORD=local-database-password
# demo, nordea or statement; changing mode requires a NEW database (see README).
BANK_MODE=demo
NORDEA_CLIENT_ID=
NORDEA_ACCOUNT_ID=
NORDEA_FROM_DATE=2026-01-01
# Files in ./secrets are ignored by git. Do not put credentials in this file.
NORDEA_CLIENT_SECRET_FILE=/run/nordea/client-secret
NORDEA_ACCESS_TOKEN_FILE=/run/nordea/access-token
# Optional RSA signing override; leave empty for Nordea's developer sandbox.
NORDEA_PRIVATE_KEY_FILE=
